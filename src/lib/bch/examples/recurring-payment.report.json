  "contract": {
    "file": "recurring-payment.cash",
    "source": "pragma cashscript ^0.14.0;\n\n// Demonstration only: review authorization and economics before deployment.\ncontract RecurringPayment(bytes20 recipient, int interval, int payment) {\n    function pay() {\n        require(this.age >= interval);\n        require(tx.outputs[0].lockingBytecode == new LockingBytecodeP2PKH(recipient));\n        require(tx.outputs[0].value >= payment);\n        require(tx.outputs[1].lockingBytecode == tx.inputs[this.activeInputIndex].lockingBytecode);\n        require(tx.outputs[1].value >= tx.inputs[this.activeInputIndex].value - payment - 1000);\n    }\n}\n",
    "name": "RecurringPayment",
    "compiler": "cashc 0.14.0",
