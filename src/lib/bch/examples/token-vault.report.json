  "contract": {
    "file": "token-vault.cash",
    "source": "pragma cashscript ^0.14.0;\n\n// Demonstrates token introspection; intentionally omits an owner withdrawal path.\ncontract TokenVault(bytes category) {\n    function preserve() {\n        require(tx.inputs[this.activeInputIndex].tokenCategory == category);\n        require(tx.outputs[0].tokenCategory == category);\n        require(tx.outputs[0].nftCommitment == tx.inputs[this.activeInputIndex].nftCommitment);\n        require(tx.outputs[0].lockingBytecode == tx.inputs[this.activeInputIndex].lockingBytecode);\n        require(tx.outputs[0].value >= tx.inputs[this.activeInputIndex].value - 1000);\n    }\n}\n",
    "name": "TokenVault",
    "compiler": "cashc 0.14.0",
    "bytecode": "c0ce788800d18800d2c0cf8800cdc0c78800ccc0c602e80394a2",
