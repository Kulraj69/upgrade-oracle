    "source": "pragma cashscript ^0.14.0;\n\n// Demonstrates repeated output construction, not a production payout policy.\ncontract OutputCovenant(bytes32 scriptHash) {\n    function distribute() {\n        bytes target = new LockingBytecodeP2SH32(scriptHash);\n        require(tx.outputs[0].lockingBytecode == target);\n        require(tx.outputs[1].lockingBytecode == target);\n        require(tx.outputs[2].lockingBytecode == target);\n    }\n}\n",
